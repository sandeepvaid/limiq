{
  "name": "@limiq/store-memory",
  "version": "0.1.0",
  "description": "In-memory (Map/LRU) store for @limiq/core — single-process, dev/test, fail-open fallback",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -b",
    "prepublishOnly": "tsc -b"
  },
  "dependencies": {
    "@limiq/core": "workspace:*"
  },
  "license": "MIT",
  "author": "Sandeep Vaid",
  "sideEffects": false,
  "keywords": [
    "rate-limit",
    "rate-limiter",
    "ratelimit",
    "throttle",
    "throttling",
    "redis",
    "typescript",
    "nodejs",
    "in-memory",
    "lru",
    "store"
  ],
  "homepage": "https://github.com/sandeepvaid/limiq#readme",
  "bugs": {
    "url": "https://github.com/sandeepvaid/limiq/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sandeepvaid/limiq.git",
    "directory": "packages/store-memory"
  },
  "publishConfig": {
    "access": "public"
  }
}
